# PostgreSQL / Supabase Connection String (Transaction Pooler for Vercel/runtime)
DATABASE_URL=

# Supabase API (Project Settings -> Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (NEVER expose to frontend or commit .env to GitHub)
SUPABASE_SERVICE_ROLE_KEY=

# Server & Auth options
PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=auto