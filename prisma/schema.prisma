// Anime Auction & Anime Debate — Unified PostgreSQL / Supabase Data Model
// Characters and anime are seeded from src/data (see prisma/seed.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum LotStatus {
  ACTIVE
  SOLD
  UNSOLD
  CANCELLED
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum DebateCategory {
  GENERAL
  POWER_SCALING
  LORE
  HOT_TAKE
}

enum ContentStatus {
  OPEN
  LOCKED
  HIDDEN
}

enum ComparisonCriteria {
  OVERALL
  COMBAT
  WRITING
  INTELLIGENCE
}

enum ComparisonSide {
  A
  B
}

enum NotificationType {
  COMMENT_ON_DEBATE
  COMMENT_ON_COMPARISON
  COMMENT_REPLY
  REACTION_MILESTONE
  BADGE_EARNED
  LEVEL_UP
  MODERATION
}

enum BadgeRuleType {
  DEBATES_COUNT
  COMPARISONS_COUNT
  COMMENTS_COUNT
  LIKES_RECEIVED
  LEVEL_REACHED
  AUCTION_WINS
}

model User {
  id                String     @id @default(cuid())
  username          String     @unique
  /// Lower-cased username used for case-insensitive uniqueness and lookups.
  usernameKey       String     @unique
  passwordHash      String
  role              UserRole   @default(USER)
  bio               String?
  /// Preset gradient avatar id (see src/lib/avatars.ts).
  avatarStyle       String     @default("violet")
  /// Optional owned character or selected character avatar.
  avatarCharacterId String?
  avatarCharacter   Character? @relation("UserAvatar", fields: [avatarCharacterId], references: [id], onDelete: SetNull)
  /// Optional custom avatar image URL (from allowed presets/storage).
  avatarCustomUrl   String?

  /// Gamification & Community Stats
  xp               Int       @default(0)
  level            Int       @default(1)
  debatesCount     Int       @default(0)
  comparisonsCount Int       @default(0)
  commentsCount    Int       @default(0)
  likesReceived    Int       @default(0)

  /// Moderation & Account Safety
  isBanned          Boolean   @default(false)
  bannedReason      String?
  usernameChangedAt DateTime?

  /// Auction Stats
  auctionWins   Int @default(0)
  auctionLosses Int @default(0)
  matchesPlayed Int @default(0)
  matchesWon    Int @default(0)
  totalSpent    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  matchPlayers       MatchPlayer[]
  bids               Bid[]
  wonLots            AuctionLot[]          @relation("LotWinner")
  owned              OwnedCharacter[]
  hostedMatches      Match[]               @relation("MatchHost")
  wonMatches         Match[]               @relation("MatchWinner")
  debates            Debate[]
  comparisons        CharacterComparison[]
  comparisonVotes    ComparisonVote[]
  comments           Comment[]
  reactions          Reaction[]
  favorites          Favorite[]
  badges             UserBadge[]
  notifications      Notification[]        @relation("NotificationRecipient")
  actedNotifications Notification[]        @relation("NotificationActor")
  xpEvents           XpEvent[]
  moderationLogs     ModerationLog[]       @relation("ModerationAdmin")

  @@index([xp])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the session token; the raw token only lives in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Anime {
  /// Stable slug, e.g. "naruto".
  id          String                @id
  name        String
  shortName   String
  color       String
  description String
  enabled     Boolean               @default(true)
  sortOrder   Int                   @default(0)
  characters  Character[]
  debates     Debate[]
}

model Character {
  /// Stable slug, e.g. "naruto-itachi-uchiha".
  id          String   @id
  name        String
  title       String
  animeId     String
  anime       Anime    @relation(fields: [animeId], references: [id])
  imageUrl    String?
  description String
  abilities   String[]
  rarity      Rarity
  powerLevel  Int?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots           AuctionLot[]
  owners         OwnedCharacter[]
  avatarOfUsers  User[]                @relation("UserAvatar")
  debates        Debate[]
  comparisonsAsA CharacterComparison[] @relation("ComparisonCharA")
  comparisonsAsB CharacterComparison[] @relation("ComparisonCharB")
  comments       Comment[]
  favorites      Favorite[]

  @@index([animeId])
  @@index([rarity])
}

model Match {
  id              String      @id @default(cuid())
  code            String      @unique
  status          MatchStatus @default(WAITING)
  isPrivate       Boolean     @default(true)
  isMatchmade     Boolean     @default(false)
  hostId          String?
  host            User?       @relation("MatchHost", fields: [hostId], references: [id], onDelete: SetNull)
  totalLots       Int
  bidSeconds      Int
  startingBalance Int
  minIncrement    Int
  animeIds        String[]
  winnerId        String?
  winner          User?       @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  endReason       String?
  createdAt       DateTime    @default(now())
  startedAt       DateTime?
  endedAt         DateTime?
  updatedAt       DateTime    @updatedAt

  players MatchPlayer[]
  lots    AuctionLot[]

  @@index([status, isPrivate])
  @@index([createdAt])
}

model MatchPlayer {
  id       String       @id @default(cuid())
  matchId  String
  match    Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat     Int
  balance  Int
  score    Int          @default(0)
  result   MatchResult?
  joinedAt DateTime     @default(now())

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId])
}

model AuctionLot {
  id            String     @id @default(cuid())
  matchId       String
  match         Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  lotNumber     Int
  characterId   String
  character     Character  @relation(fields: [characterId], references: [id])
  startingPrice Int
  status        LotStatus  @default(ACTIVE)
  winnerId      String?
  winner        User?      @relation("LotWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  finalPrice    Int?
  startedAt     DateTime   @default(now())
  endedAt       DateTime?

  bids Bid[]

  @@unique([matchId, lotNumber])
  @@index([characterId])
  @@index([winnerId])
}

model Bid {
  id        String     @id @default(cuid())
  lotId     String
  lot       AuctionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime   @default(now())

  @@index([lotId])
  @@index([userId])
}

model OwnedCharacter {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId    String
  character      Character @relation(fields: [characterId], references: [id])
  copies         Int       @default(1)
  lastPrice      Int
  totalSpent     Int
  acquiredAt     DateTime  @default(now())
  lastAcquiredAt DateTime  @default(now())
  sourceMatchId  String?

  @@unique([userId, characterId])
  @@index([characterId])
}

// ─── Anime Debate Community Models ──────────────────────────────────────────

model Debate {
  id            String         @id @default(cuid())
  slug          String         @unique
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  animeId       String?
  anime         Anime?         @relation(fields: [animeId], references: [id], onDelete: SetNull)
  characterId   String?
  character     Character?     @relation(fields: [characterId], references: [id], onDelete: SetNull)
  title         String
  content       String
  category      DebateCategory @default(GENERAL)
  status        ContentStatus  @default(OPEN)
  isPinned      Boolean        @default(false)
  likesCount    Int            @default(0)
  dislikesCount Int            @default(0)
  commentsCount Int            @default(0)
  viewsCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  comments  Comment[]
  reactions Reaction[]
  favorites Favorite[]

  @@index([status, isPinned, createdAt])
  @@index([authorId])
  @@index([animeId])
  @@index([characterId])
}

model CharacterComparison {
  id            String             @id @default(cuid())
  slug          String             @unique
  authorId      String
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  characterAId  String
  characterA    Character          @relation("ComparisonCharA", fields: [characterAId], references: [id])
  characterBId  String
  characterB    Character          @relation("ComparisonCharB", fields: [characterBId], references: [id])
  title         String
  description   String
  criteria      ComparisonCriteria @default(OVERALL)
  status        ContentStatus      @default(OPEN)
  votesACount   Int                @default(0)
  votesBCount   Int                @default(0)
  likesCount    Int                @default(0)
  dislikesCount Int                @default(0)
  commentsCount Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  sideVotes ComparisonVote[]
  comments  Comment[]
  reactions Reaction[]
  favorites Favorite[]

  @@index([status, createdAt])
  @@index([authorId])
  @@index([characterAId])
  @@index([characterBId])
}

model ComparisonVote {
  id           String              @id @default(cuid())
  comparisonId String
  comparison   CharacterComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  side         ComparisonSide
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([comparisonId, userId])
  @@index([userId])
}

model Comment {
  id            String               @id @default(cuid())
  authorId      String
  author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  debateId      String?
  debate        Debate?              @relation(fields: [debateId], references: [id], onDelete: Cascade)
  comparisonId  String?
  comparison    CharacterComparison? @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  characterId   String?
  character     Character?           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        Comment?             @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]            @relation("CommentReplies")
  body          String
  likesCount    Int                  @default(0)
  dislikesCount Int                  @default(0)
  isDeleted     Boolean              @default(false)
  editedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  reactions Reaction[]

  @@index([debateId, createdAt])
  @@index([comparisonId, createdAt])
  @@index([characterId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  debateId     String?
  debate       Debate?              @relation(fields: [debateId], references: [id], onDelete: Cascade)
  comparisonId String?
  comparison   CharacterComparison? @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      Comment?             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// 1 = Like, -1 = Dislike
  value        Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, debateId])
  @@unique([userId, comparisonId])
  @@unique([userId, commentId])
  @@index([debateId])
  @@index([comparisonId])
  @@index([commentId])
}

model Favorite {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId  String?
  character    Character?           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  debateId     String?
  debate       Debate?              @relation(fields: [debateId], references: [id], onDelete: Cascade)
  comparisonId String?
  comparison   CharacterComparison? @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  @@unique([userId, characterId])
  @@unique([userId, debateId])
  @@unique([userId, comparisonId])
  @@index([userId, createdAt])
}

model Badge {
  id          String        @id
  slug        String        @unique
  name        String
  description String
  icon        String
  color       String
  ruleType    BadgeRuleType
  threshold   Int
  createdAt   DateTime      @default(now())

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ModerationLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}
